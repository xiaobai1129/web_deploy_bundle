#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer WeightBuf {
    uint weights_u32[];
};

layout(std430, binding = 1) readonly buffer BufA {
    float buf_a[];
};

layout(std430, binding = 2) readonly buffer BufB {
    float buf_b[];
};

layout(std430, binding = 3) buffer DstBuf {
    float dst_buf[];
};

// Dispatch / tensor shape uniforms
uniform int u_op;         // 0=bicubic, 1=unshuffle2, 2=conv3x3, 3=span_combine, 4=shuffle_r, 5=seam_lut, 6=add_trust_clamp
uniform int u_in_c;
uniform int u_in_h;
uniform int u_in_w;
uniform int u_out_c;
uniform int u_out_h;
uniform int u_out_w;

// Weight offset uniforms (indices in float16 elements inside WeightBuf)
uniform uint u_w_off;
uniform uint u_b_off;
uniform uint u_pb_off;
uniform uint u_act_off;
uniform int u_has_pb;
uniform int u_has_act;

// Op-specific parameters
uniform int u_scale_r;
uniform int u_add_b;
uniform float u_alpha;
uniform float u_beta;
uniform float u_delta;

float read_fp16(uint elem_idx) {
    uint word = weights_u32[elem_idx >> 1u];
    vec2 pair = unpackHalf2x16(word);
    return ((elem_idx & 1u) == 0u) ? pair.x : pair.y;
}

// PyTorch F.interpolate(mode="bicubic", align_corners=False) uses Keys a = -0.75
float cubic_w(float t) {
    float x = abs(t);
    const float a = -0.75;
    if (x <= 1.0) {
        return ((a + 2.0) * x - (a + 3.0)) * x * x + 1.0;
    } else if (x < 2.0) {
        return ((a * x - 5.0 * a) * x + 8.0 * a) * x - 4.0 * a;
    }
    return 0.0;
}

void op_bicubic(int ox, int oy) {
    float sx = (float(ox) + 0.5) * (float(u_in_w) / float(u_out_w)) - 0.5;
    float sy = (float(oy) + 0.5) * (float(u_in_h) / float(u_out_h)) - 0.5;
    int ix0 = int(floor(sx));
    int iy0 = int(floor(sy));

    float acc = 0.0;
    for (int dy = -1; dy <= 2; ++dy) {
        int ry = clamp(iy0 + dy, 0, u_in_h - 1);
        float wy = cubic_w(sy - float(iy0 + dy));
        for (int dx = -1; dx <= 2; ++dx) {
            int rx = clamp(ix0 + dx, 0, u_in_w - 1);
            float wx = cubic_w(sx - float(ix0 + dx));
            acc += (wy * wx) * buf_a[ry * u_in_w + rx];
        }
    }
    dst_buf[oy * u_out_w + ox] = acc;
}

void op_unshuffle2(int ox, int oy) {
    for (int c = 0; c < u_in_c; ++c) {
        int base_in = c * (u_in_h * u_in_w);
        for (int dy = 0; dy < 2; ++dy) {
            int iy = oy * 2 + dy;
            for (int dx = 0; dx < 2; ++dx) {
                int ix = ox * 2 + dx;
                int oc = c * 4 + dy * 2 + dx;
                int out_idx = (oc * u_out_h + oy) * u_out_w + ox;
                dst_buf[out_idx] = buf_a[base_in + iy * u_in_w + ix];
            }
        }
    }
}

void op_conv3x3(int ox, int oy) {
    int in_hw = u_in_h * u_in_w;
    int out_hw = u_out_h * u_out_w;
    int pb_y = oy & 7;
    int pb_x = ox & 7;

    for (int co = 0; co < u_out_c; ++co) {
        float acc = read_fp16(u_b_off + uint(co));
        uint w_co_base = u_w_off + uint(co * u_in_c * 9);

        for (int ky = 0; ky < 3; ++ky) {
            int iy = oy + ky - 1;
            if (iy < 0 || iy >= u_in_h) {
                continue;
            }
            for (int kx = 0; kx < 3; ++kx) {
                int ix = ox + kx - 1;
                if (ix < 0 || ix >= u_in_w) {
                    continue;
                }
                int k_off = ky * 3 + kx;
                int in_pix = iy * u_in_w + ix;
                for (int ci = 0; ci < u_in_c; ++ci) {
                    float w = read_fp16(w_co_base + uint(ci * 9 + k_off));
                    acc += w * buf_a[ci * in_hw + in_pix];
                }
            }
        }

        if (u_has_pb != 0) {
            acc += read_fp16(u_pb_off + uint((co * 8 + pb_y) * 8 + pb_x));
        }
        if (u_has_act != 0 && acc < 0.0) {
            acc *= read_fp16(u_act_off + uint(co));
        }
        dst_buf[co * out_hw + oy * u_out_w + ox] = acc;
    }
}

void op_span_combine(int ox, int oy) {
    int hw = u_out_h * u_out_w;
    int pix = oy * u_out_w + ox;
    for (int c = 0; c < u_out_c; ++c) {
        int idx = c * hw + pix;
        dst_buf[idx] = dst_buf[idx] + u_alpha * buf_a[idx] + u_beta * buf_b[idx];
    }
}

void op_shuffle_r(int ox, int oy) {
    int r = u_scale_r;
    int iy = oy / r;
    int dy = oy - iy * r;
    int ix = ox / r;
    int dx = ox - ix * r;
    int sub = dy * r + dx;
    int r2 = r * r;
    int in_hw = u_in_h * u_in_w;
    int out_hw = u_out_h * u_out_w;
    int in_pix = iy * u_in_w + ix;
    int out_pix = oy * u_out_w + ox;

    for (int c = 0; c < u_out_c; ++c) {
        int ic = c * r2 + sub;
        float val = buf_a[ic * in_hw + in_pix];
        int out_idx = c * out_hw + out_pix;
        if (u_add_b != 0) {
            val += buf_b[out_idx];
        }
        dst_buf[out_idx] = val;
    }
}

float lut_sample(float d_norm, float h_norm, float w_norm) {
    // Table shape (17, 17, 17), align_corners=True on [0, 1] -> [0, 16]
    float fd = clamp(d_norm, 0.0, 1.0) * 16.0;
    float fh = clamp(h_norm, 0.0, 1.0) * 16.0;
    float fw = clamp(w_norm, 0.0, 1.0) * 16.0;
    int d0 = int(floor(fd));
    int h0 = int(floor(fh));
    int w0 = int(floor(fw));
    int d1 = min(d0 + 1, 16);
    int h1 = min(h0 + 1, 16);
    int w1 = min(w0 + 1, 16);
    float td = fd - float(d0);
    float th = fh - float(h0);
    float tw = fw - float(w0);

    float c000 = read_fp16(u_w_off + uint((d0 * 17 + h0) * 17 + w0));
    float c001 = read_fp16(u_w_off + uint((d0 * 17 + h0) * 17 + w1));
    float c010 = read_fp16(u_w_off + uint((d0 * 17 + h1) * 17 + w0));
    float c011 = read_fp16(u_w_off + uint((d0 * 17 + h1) * 17 + w1));
    float c100 = read_fp16(u_w_off + uint((d1 * 17 + h0) * 17 + w0));
    float c101 = read_fp16(u_w_off + uint((d1 * 17 + h0) * 17 + w1));
    float c110 = read_fp16(u_w_off + uint((d1 * 17 + h1) * 17 + w0));
    float c111 = read_fp16(u_w_off + uint((d1 * 17 + h1) * 17 + w1));

    float c00 = mix(c000, c001, tw);
    float c01 = mix(c010, c011, tw);
    float c10 = mix(c100, c101, tw);
    float c11 = mix(c110, c111, tw);
    float c0 = mix(c00, c01, th);
    float c1 = mix(c10, c11, th);
    return mix(c0, c1, td);
}

float eval_seam_lr(int lx, int ly) {
    int cx = clamp(lx, 0, u_in_w - 1);
    int cy = clamp(ly, 0, u_in_h - 1);
    int xm = max(cx - 1, 0);
    int xp = min(cx + 1, u_in_w - 1);
    int ym = max(cy - 1, 0);
    int yp = min(cy + 1, u_in_h - 1);

    float xc = buf_a[cy * u_in_w + cx];
    float dh_l = clamp(0.5 * (buf_a[cy * u_in_w + xm] - xc) + 0.5, 0.0, 1.0);
    float dh_r = clamp(0.5 * (buf_a[cy * u_in_w + xp] - xc) + 0.5, 0.0, 1.0);
    float dv_u = clamp(0.5 * (buf_a[ym * u_in_w + cx] - xc) + 0.5, 0.0, 1.0);
    float dv_d = clamp(0.5 * (buf_a[yp * u_in_w + cx] - xc) + 0.5, 0.0, 1.0);

    float lh = lut_sample(xc, dh_l, dh_r);
    float lv = lut_sample(xc, dv_u, dv_d);
    float mask = read_fp16(u_b_off + uint((cy & 7) * 8 + (cx & 7)));
    return 0.5 * (lh + lv) * mask;
}

void op_seam_lut(int ox, int oy) {
    // Bilinear upsample align_corners=False from (u_in_h, u_in_w) to (u_out_h, u_out_w)
    float sx = clamp((float(ox) + 0.5) * (float(u_in_w) / float(u_out_w)) - 0.5, 0.0, float(u_in_w - 1));
    float sy = clamp((float(oy) + 0.5) * (float(u_in_h) / float(u_out_h)) - 0.5, 0.0, float(u_in_h - 1));
    int x0 = int(floor(sx));
    int y0 = int(floor(sy));
    int x1 = min(x0 + 1, u_in_w - 1);
    int y1 = min(y0 + 1, u_in_h - 1);
    float fx = sx - float(x0);
    float fy = sy - float(y0);

    float v00 = eval_seam_lr(x0, y0);
    float v01 = eval_seam_lr(x1, y0);
    float v10 = eval_seam_lr(x0, y1);
    float v11 = eval_seam_lr(x1, y1);
    float delta = mix(mix(v00, v01, fx), mix(v10, v11, fx), fy);

    int out_idx = oy * u_out_w + ox;
    dst_buf[out_idx] = dst_buf[out_idx] + delta;
}

void op_add_trust_clamp(int ox, int oy) {
    int out_idx = oy * u_out_w + ox;
    float y_raw = buf_a[out_idx] + dst_buf[out_idx];

    // Exact F.interpolate(mode="nearest") coordinate mapping
    int lcx = clamp((ox * u_in_w) / u_out_w, 0, u_in_w - 1);
    int lcy = clamp((oy * u_in_h) / u_out_h, 0, u_in_h - 1);

    float y_min = 1e9;
    float y_max = -1e9;
    for (int dy = -1; dy <= 1; ++dy) {
        int ry = clamp(lcy + dy, 0, u_in_h - 1);
        for (int dx = -1; dx <= 1; ++dx) {
            int rx = clamp(lcx + dx, 0, u_in_w - 1);
            float v = buf_b[ry * u_in_w + rx];
            y_min = min(y_min, v);
            y_max = max(y_max, v);
        }
    }

    float lo = y_min - u_delta;
    float hi = y_max + u_delta;
    dst_buf[out_idx] = clamp(clamp(y_raw, lo, hi), 0.0, 1.0);
}

void main() {
    int ox = int(gl_GlobalInvocationID.x);
    int oy = int(gl_GlobalInvocationID.y);
    if (ox >= u_out_w || oy >= u_out_h) {
        return;
    }

    if (u_op == 0) {
        op_bicubic(ox, oy);
    } else if (u_op == 1) {
        op_unshuffle2(ox, oy);
    } else if (u_op == 2) {
        op_conv3x3(ox, oy);
    } else if (u_op == 3) {
        op_span_combine(ox, oy);
    } else if (u_op == 4) {
        op_shuffle_r(ox, oy);
    } else if (u_op == 5) {
        op_seam_lut(ox, oy);
    } else if (u_op == 6) {
        op_add_trust_clamp(ox, oy);
    }
}
